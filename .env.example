# ─────────────────────────────────────────────────────────────────────────────
#  Bus Tracker — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Flask environment: 'production' enables secure cookies and disables debug
FLASK_ENV=production

# Secret key for session signing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# One-time bootstrap authorization. Required only while the application is not installed.
# Generate independently and remove it from the environment after installation.
INSTALL_TOKEN=replace-with-a-random-bootstrap-token

# Dedicated Fernet key for encrypted disaster-recovery backups.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=replace-with-a-fernet-key
# Dedicated Fernet key for SMTP credentials. Keep it stable and backed up securely.
# Generate independently with the same Fernet command shown above.
EMAIL_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-different-fernet-key
RESTORE_JOB_TTL_SECONDS=1800
RESTORE_SNAPSHOT_RETENTION_DAYS=30

# ── Database ──────────────────────────────────────────────────────────────────

# SQLite (simple, no extra service needed)
# DATABASE_URL=sqlite:///bustrack.db

# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://bususer:replace-with-a-strong-password@localhost:5432/bustrack

# PostgreSQL credentials (used by docker-compose.yml)
DB_NAME=bustrack
DB_USER=bususer
DB_PASS=

# Exact SMTP hosts allowed for configuration and diagnostics. Google and Microsoft
# presets are already allowed; list any approved custom relay here.
SMTP_ALLOWED_HOSTS=
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_RETRY_BASE_SECONDS=60
EMAIL_OUTBOX_RETRY_MAX_SECONDS=3600
EMAIL_OUTBOX_BATCH_SIZE=50

# Set these only when requests arrive through that many trusted reverse proxies.
TRUSTED_PROXY_X_FOR=0
TRUSTED_PROXY_X_PROTO=0
TRUSTED_PROXY_X_HOST=0

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCK_SECONDS=300

# Security and private import staging. Keep PowerSchool disabled until a validated pilot.
BROADCAST_JOB_TTL_SECONDS=86400
IMPORT_MAX_ROWS=25000
IMPORT_MAX_COLUMNS=64
IMPORT_STAGE_TTL_HOURS=24
POWERSCHOOL_IMPORT_ENABLED=0
POWERSCHOOL_ROLLBACK_RETENTION_DAYS=30
BUS_TRASH_RETENTION_DAYS=90

# CSP_REPORT_ONLY can be enabled during a deployment observation window. The
# enforced policy remains on by default; do not disable it to bypass violations.
CSP_ENFORCE=1
CSP_REPORT_ONLY=0

# ── Optional ──────────────────────────────────────────────────────────────────

# Port to expose (default: 5000)
# PORT=5000
